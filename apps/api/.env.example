# Variables de l'API lues par `manage.py` depuis apps/api/.env (fichier local, ignoré par git, jamais versionné).
# Copier ce fichier en `.env` et remplacer les valeurs factices. Aucun secret réel dans le dépôt.

# Facture normalisée e-MECeF (ADR 0006) : `fake` en local, `emecef` pour vérifier l'accès avec `emecef_check`
FISCAL_PROVIDER=fake
# URL de l'API e-MCF de la DGI (sans barre finale) : valeur factice
EMECEF_API_URL=https://example.invalid/sygmef-emcf
# IFU de Steamy : valeur factice
EMECEF_IFU=0000000000000
# Jeton d'API (JWT) lié à l'IFU : valeur factice, le vrai se met dans .env ou dans le secret de déploiement
EMECEF_TOKEN=remplacer-par-le-jeton-de-la-dgi
