# Variables de l'API pour la stack Docker LOCALE uniquement.
# Identifiants factices : ce fichier est versionné volontairement.
# Ne jamais y mettre de vrai secret (clés FedaPay sandbox, SMTP réel…) :
# les déclarer dans un compose.override.yml (gitignoré) à la racine.

DJANGO_ENV=dev
SECRET_KEY=dev-insecure-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1,api
ALLOW_API_DOCS=true
WEB_URL=http://localhost:3000

# PostgreSQL
POSTGRES_DB=steamy
POSTGRES_USER=steamy
POSTGRES_PASSWORD=steamy
POSTGRES_HOST=postgres

# Redis / Celery
REDIS_HOST=redis
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0

# Stockage S3 (RustFS)
AWS_S3_ENDPOINT_URL=http://rustfs:9000
AWS_ACCESS_KEY_ID=rustfsadmin
AWS_SECRET_ACCESS_KEY=rustfsadmin
AWS_STORAGE_BUCKET_NAME=steamy-media
AWS_S3_REGION_NAME=us-east-1

# E-mails capturés par Mailpit (http://localhost:8025)
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=0
EMAIL_HOST_USER=dev
EMAIL_HOST_PASSWORD=dev
DEFAULT_FROM_EMAIL=no-reply@steamy.local

# SMS : faux fournisseur, chaque SMS arrive dans Mailpit adressé à <numéro E.164>@sms.test (ADR 0002).
# Jamais de vrai SMS en local ni en CI.
SMS_PROVIDER=fake

# Paiement : faux prestataire pilotable par le numéro saisi (…01 succès, …02 échec, …03 en attente), qui poste
# lui-même son webhook signé (ADR 0003). Jamais de vrai paiement en local ni en CI.
PAYMENT_PROVIDER=fake
